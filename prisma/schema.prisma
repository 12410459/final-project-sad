// Prisma Schema for Sistem Informasi Manajemen Bimbel Cerdas
// Sesuai 14 Entitas Domain ERD & Spesifikasi Kebutuhan

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. OrangTua
model OrangTua {
  id_orang_tua String   @id @default(uuid())
  no_hp        String
  email        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  siswa Siswa[]

  @@map("orang_tua")
}

// 2. Siswa
model Siswa {
  id_siswa       String   @id @default(uuid())
  id_orang_tua   String
  id_program     String
  nama_siswa     String
  tanggal_daftar DateTime @default(now())
  status_siswa   String   @default("TERDAFTAR") // TERDAFTAR, AKTIF, MENUNGGU_KELAS, NONAKTIF
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  orang_tua             OrangTua              @relation(fields: [id_orang_tua], references: [id_orang_tua], onDelete: Cascade)
  program               Program               @relation(fields: [id_program], references: [id_program])
  penempatan            Penempatan[]
  absensi               Absensi[]
  tindak_lanjut_absensi TindakLanjutAbsensi[]
  tagihan               Tagihan[]

  @@map("siswa")
}

// 3. Program
model Program {
  id_program        String   @id @default(uuid())
  nama_program      String
  tarif_spp         Decimal  @db.Decimal(12, 2)
  biaya_pendaftaran Decimal  @default(100000.00) @db.Decimal(12, 2)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  siswa Siswa[]
  kelas Kelas[]

  @@map("program")
}

// 4. MataPelajaran
model MataPelajaran {
  id_mapel   String   @id @default(uuid())
  nama_mapel String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  kelas Kelas[]

  @@map("mata_pelajaran")
}

// 5. Tutor
model Tutor {
  id_tutor     String   @id @default(uuid())
  nama_tutor   String
  kontak_tutor String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  kelas_utama  Kelas[]      @relation("TutorUtamaKelas")
  sesi_diampu  Sesi[]       @relation("TutorPengampuSesi")
  rekap_honor  RekapHonor[]

  @@map("tutor")
}

// 6. Kelas
model Kelas {
  id_kelas       String   @id @default(uuid())
  id_program     String
  id_mapel       String
  id_tutor_utama String
  nama_kelas     String
  kapasitas_maks Int      @default(8)
  status_kelas   String   @default("MENUNGGU") // MENUNGGU (<3), BERJALAN (>=3), SELESAI
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  program     Program       @relation(fields: [id_program], references: [id_program])
  mapel       MataPelajaran @relation(fields: [id_mapel], references: [id_mapel])
  tutor_utama Tutor         @relation("TutorUtamaKelas", fields: [id_tutor_utama], references: [id_tutor])

  jadwal     Jadwal[]
  penempatan Penempatan[]
  sesi       Sesi[]

  @@map("kelas")
}

// 7. Jadwal
model Jadwal {
  id_jadwal            String   @id @default(uuid())
  id_kelas             String
  hari                 String   // Senin, Selasa, dll
  jam_mulai            String   // '15:30'
  jam_selesai          String   // '17:00'
  frekuensi_per_minggu Int      @default(2)
  durasi_menit         Int      @default(90)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  kelas Kelas  @relation(fields: [id_kelas], references: [id_kelas], onDelete: Cascade)
  sesi  Sesi[]

  @@map("jadwal")
}

// 8. Penempatan
model Penempatan {
  id_penempatan      String   @id @default(uuid())
  id_siswa           String
  id_kelas           String
  tanggal_penempatan DateTime @default(now())
  status_penempatan  String   // DITEMPATKAN, DAFTAR_TUNGGU, DIBATALKAN
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  siswa Siswa @relation(fields: [id_siswa], references: [id_siswa], onDelete: Cascade)
  kelas Kelas @relation(fields: [id_kelas], references: [id_kelas], onDelete: Cascade)

  @@map("penempatan")
}

// 9. Sesi
model Sesi {
  id_sesi           String   @id @default(uuid())
  id_kelas          String
  id_jadwal         String?
  id_tutor_pengampu String
  tanggal_sesi      DateTime
  status_sesi       String   @default("BERLANGSUNG") // BERLANGSUNG, BATAL
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  kelas          Kelas        @relation(fields: [id_kelas], references: [id_kelas], onDelete: Cascade)
  jadwal         Jadwal?      @relation(fields: [id_jadwal], references: [id_jadwal])
  tutor_pengampu Tutor        @relation("TutorPengampuSesi", fields: [id_tutor_pengampu], references: [id_tutor])
  absensi        Absensi[]

  @@map("sesi")
}

// 10. Absensi
model Absensi {
  id_absensi       String   @id @default(uuid())
  id_sesi          String
  id_siswa         String
  status_kehadiran String   // HADIR, TIDAK_HADIR, IZIN, SAKIT
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  sesi  Sesi  @relation(fields: [id_sesi], references: [id_sesi], onDelete: Cascade)
  siswa Siswa @relation(fields: [id_siswa], references: [id_siswa], onDelete: Cascade)

  @@unique([id_sesi, id_siswa])
  @@map("absensi")
}

// 11. TindakLanjutAbsensi
model TindakLanjutAbsensi {
  id_tindak_lanjut String   @id @default(uuid())
  id_siswa         String
  tanggal_telepon  DateTime @default(now())
  hasil_telepon    String   @db.Text
  catatan          String?  @db.Text
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  siswa Siswa @relation(fields: [id_siswa], references: [id_siswa], onDelete: Cascade)

  @@map("tindak_lanjut_absensi")
}

// 12. Tagihan
model Tagihan {
  id_tagihan     String   @id @default(uuid())
  id_siswa       String
  periode        String   // '2026-11' atau 'PENDAFTARAN'
  jenis_tagihan  String   // SPP_BULANAN, BIAYA_PENDAFTARAN
  nominal        Decimal  @db.Decimal(12, 2)
  diskon_persen  Decimal  @default(0.00) @db.Decimal(5, 2)
  total_tagihan  Decimal  @db.Decimal(12, 2)
  status_tagihan String   @default("BELUM_LUNAS") // BELUM_LUNAS, SEBAGIAN, LUNAS
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  siswa      Siswa        @relation(fields: [id_siswa], references: [id_siswa], onDelete: Cascade)
  pembayaran Pembayaran[]

  @@map("tagihan")
}

// 13. Pembayaran
model Pembayaran {
  id_pembayaran  String   @id @default(uuid())
  id_tagihan     String
  tanggal_bayar  DateTime @default(now())
  jumlah_bayar   Decimal  @db.Decimal(12, 2)
  nomor_kuitansi String   @unique
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  tagihan Tagihan @relation(fields: [id_tagihan], references: [id_tagihan], onDelete: Cascade)

  @@map("pembayaran")
}

// 14. RekapHonor
model RekapHonor {
  id_rekap_honor String   @id @default(uuid())
  id_tutor       String
  periode        String   // '2026-11'
  jumlah_sesi    Int
  tarif_per_sesi Decimal  @default(75000.00) @db.Decimal(12, 2)
  total_honor    Decimal  @db.Decimal(12, 2)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  tutor Tutor @relation(fields: [id_tutor], references: [id_tutor])

  @@map("rekap_honor")
}
