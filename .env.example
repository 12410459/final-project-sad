# Server Port
PORT=4000
VITE_API_URL=http://localhost:4000/api

# Node Environment: 'development' atau 'production'
# Pada mode 'development', jika PostgreSQL belum berjalan, server akan menggunakan In-Memory Demo Store dengan peringatan di log dan UI.
# Pada mode 'production', kegagalan koneksi PostgreSQL akan menghentikan server demi integritas data.
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# Contoh jika memakai Docker Compose (docker-compose up -d):
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/bimbel_cerdas?schema=public"
